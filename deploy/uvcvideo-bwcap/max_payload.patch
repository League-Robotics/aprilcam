+	/*
+	 * bwcap (local patch): many UVC cameras request their largest
+	 * isochronous altsetting for MJPEG regardless of resolution or frame
+	 * rate, so two or three of them cannot share one USB 2.0 hub even
+	 * though their real streams would fit. Cap the requested payload so a
+	 * smaller altsetting is chosen. 0 disables the cap.
+	 */
+	if (uvc_max_payload_param && stream->intf->num_altsetting > 1 &&
+	    ctrl->dwMaxPayloadTransferSize > uvc_max_payload_param) {
+		uvc_dbg(stream->dev, VIDEO,
+			"bwcap: dwMaxPayloadTransferSize %u -> %u\n",
+			ctrl->dwMaxPayloadTransferSize, uvc_max_payload_param);
+		ctrl->dwMaxPayloadTransferSize = uvc_max_payload_param;
+	}
